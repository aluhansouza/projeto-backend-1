# ============================
# PROJETO
# ============================
COMPOSE_PROJECT_NAME=backend-dev

# ============================
# SPRING BOOT
# ============================
SPRING_PROFILES_ACTIVE=dev

JWT_SECRET=chave-jwt-exemplo

# ============================
# BANCO DE DADOS
# ============================
DB_HOST=mariadb
DB_PORT=3306
DB_NOME=db_nome
DB_USUARIO=usuario_db
DB_SENHA=senha_segura

MARIA_ROOT_PASSWORD=rootSenhaSegura

# ============================
# FLYWAY
# ============================
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# ============================
# EMAIL
# ============================
USUARIO_EMAIL=seu-email@exemplo.com
CHAVE_APP=chave-app-exemplo

# ============================
# UPLOADS
# ============================
UPLOADS=/app/uploads

# ============================
# TIMEZONE
# ============================
TZ=America/Manaus